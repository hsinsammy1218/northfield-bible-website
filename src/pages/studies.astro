---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecordingArchive from "../components/RecordingArchive.astro";
import { site } from "../data/site";
import studies from "../data/studies.json";

const description =
  "Bible studies at Northfield Bible Church: Sunday Doctrines Class, Wednesday Bible Study, and Thursday Women's Study, with online recordings.";
---

<BaseLayout title="Studies" description={description} canonicalPath="/studies">
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <h1 class="page-title">Bible studies</h1>
        <p>
          Online recordings of our studies and classes. Everyone is welcome at any of our weekly
          gatherings.
        </p>
      </div>

      <ul class="schedule-list reveal" style="margin-bottom: 1rem;">
        {
          site.schedule.map((item) => (
            <li>
              <span class="meta">
                {item.day} · {item.time}
              </span>
              <h2 style="margin:0; font-family: var(--font-serif); font-size: 1.25rem;">{item.title}</h2>
              <p>{item.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-alt" id="doctrines">
    <div class="container">
      <div class="section-header">
        <h2>Doctrines Class recordings</h2>
        <p>Sunday morning class at 9:00 AM, before worship.</p>
      </div>
      <RecordingArchive
        items={studies.doctrines}
        searchLabel="Search doctrines recordings"
        emptyMessage="No doctrines recordings match your search."
        idPrefix="doctrines"
      />
    </div>
  </section>

  <section class="section" id="wednesday">
    <div class="container">
      <div class="section-header">
        <h2>Wednesday Study recordings</h2>
        <p>Mid-week Bible study at 7:00 PM.</p>
      </div>
      <RecordingArchive
        items={studies.wednesday}
        searchLabel="Search Wednesday study recordings"
        emptyMessage="No Wednesday recordings match your search."
        idPrefix="wednesday"
      />
    </div>
  </section>
</BaseLayout>
