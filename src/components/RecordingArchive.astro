---
interface Recording {
  date: string | null;
  year: number | null;
  title: string;
  audioUrl?: string | null;
  videoUrl?: string | null;
  pdfUrl?: string | null;
  kind?: string;
}

interface Props {
  items: Recording[];
  searchLabel?: string;
  emptyMessage?: string;
  idPrefix?: string;
}

const {
  items,
  searchLabel = "Search by title",
  emptyMessage = "No recordings match your search.",
  idPrefix = "archive",
} = Astro.props;

const years = [
  ...new Set(items.map((item) => item.year).filter((year): year is number => year != null)),
].sort((a, b) => b - a);

function formatDate(iso: string | null) {
  if (!iso) return "Date unavailable";
  const [y, m, d] = iso.split("-").map(Number);
  if (!y || !m || !d) return iso;
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<div class="archive" data-archive>
  <div class="filters">
    <label>
      {searchLabel}
      <input
        type="search"
        name="q"
        placeholder="Example: Rejoicing Through the Fire"
        autocomplete="off"
        data-archive-search
        id={`${idPrefix}-search`}
      />
    </label>
    <label>
      Year
      <select data-archive-year id={`${idPrefix}-year`}>
        <option value="all">All years</option>
        {years.map((year) => <option value={String(year)}>{year}</option>)}
      </select>
    </label>
  </div>

  <p class="recording-date" data-archive-count aria-live="polite">
    Showing {items.length} recording{items.length === 1 ? "" : "s"}
  </p>

  <ul class="recording-list" data-archive-list>
    {
      items.map((item) => (
        <li
          class="recording-item"
          data-title={item.title.toLowerCase()}
          data-year={item.year ?? ""}
        >
          <div>
            <p class="recording-date">{formatDate(item.date)}</p>
            <h3>{item.title}</h3>
          </div>
          <div class="recording-actions">
            {item.audioUrl && (
              <a href={item.audioUrl} target="_blank" rel="noopener noreferrer">
                {/\.pdf(?:\?|$)/i.test(item.audioUrl) ? "PDF" : "Audio"}
              </a>
            )}
            {item.videoUrl && (
              <a href={item.videoUrl} target="_blank" rel="noopener noreferrer">
                Video
              </a>
            )}
            {item.pdfUrl && (
              <a href={item.pdfUrl} target="_blank" rel="noopener noreferrer">
                PDF
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="empty-state" data-archive-empty hidden>{emptyMessage}</p>
</div>

<script>
  function initArchive(root: Element) {
    const search = root.querySelector("[data-archive-search]");
    const yearSelect = root.querySelector("[data-archive-year]");
    const list = root.querySelector("[data-archive-list]");
    const empty = root.querySelector("[data-archive-empty]");
    const count = root.querySelector("[data-archive-count]");
    if (
      !(search instanceof HTMLInputElement) ||
      !(yearSelect instanceof HTMLSelectElement) ||
      !(list instanceof HTMLElement) ||
      !(empty instanceof HTMLElement) ||
      !(count instanceof HTMLElement)
    ) {
      return;
    }

    const items = [...list.querySelectorAll(".recording-item")];

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      const year = yearSelect.value;
      let visible = 0;

      for (const item of items) {
        if (!(item instanceof HTMLElement)) continue;
        const title = item.dataset.title ?? "";
        const itemYear = item.dataset.year ?? "";
        const matchesQuery = !q || title.includes(q);
        const matchesYear = year === "all" || itemYear === year;
        const show = matchesQuery && matchesYear;
        item.hidden = !show;
        if (show) visible += 1;
      }

      empty.hidden = visible > 0;
      list.hidden = visible === 0;
      count.textContent = `Showing ${visible} recording${visible === 1 ? "" : "s"}`;
    };

    search.addEventListener("input", apply);
    yearSelect.addEventListener("change", apply);
  }

  document.querySelectorAll("[data-archive]").forEach(initArchive);
</script>
